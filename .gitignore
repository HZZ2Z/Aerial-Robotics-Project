# --- simulation outputs (regenerable by main.m) ---
results/*.mat

# --- LaTeX build artifacts ---
report/*.pdf
report/*.log
report/*.aux
report/*.xdv
report/*.synctex.gz

# --- local LaTeX toolchain (portable, not part of the project) ---
tectonic/

# --- MATLAB caches ---
*.slxc
*.asv
*.mex*
autosave/

# --- misc ---
_render/
Thumbs.db
.DS_Store

# --- Simulink cache ---
slprj/
matlab/slprj/

# --- course statements (do not redistribute) ---
project2026*.pdf

# --- session artifacts & redundant submission zip (code lives here) ---
.zcode/
AerialRobotics_2026_code.zip

# --- autoresearch session state ---
# (.auto/ is excluded from experiment commits via the plugin's pathspec;
#  ignoring .auto/ itself breaks `git add -A -- . :(exclude).auto`)
autoresearch-dashboard.html
.auto/bench_last.txt

# --- recursive mat ignore + large diagnostic dirs (dir-level so git skips traversal) ---
results/**/*.mat
results/scratch/
results/diag_*/
results/legacy_*/

# Local course inputs and generated submission files
deliver/
simulink/student_kit/
simulink/quad_arch.slx
